# Copy to .env (NEVER commit the real key — submission checklist requirement)

# Local Gemma 4 via Ollama (default path — tiny, offline, still Gemma-only)
GEMMA_MODE=local
GEMMA_LOCAL_MODEL=gemma4:e2b-it-qat
OLLAMA_HOST=http://localhost:11434
# Keep this at 1 unless the machine can safely run multiple Gemma requests.
GEMMA_POOL_SIZE=1
GEMMA_TIMEOUT_SECONDS=150

# Cloud Gemma 4 (judged-demo path): get a key at https://aistudio.google.com
# GEMMA_MODE=cloud
# GEMINI_API_KEY=your_key_from_aistudio_google_com
# GEMMA_MODEL=gemma-4-26b-a4b-it
